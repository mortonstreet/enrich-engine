// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator prisma {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

generator client {
  provider = "prisma-kysely"
  output   = "../src/generated"
  fileName = "types.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(uuid())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @default(now()) @updatedAt
  email                    String
  emailVerified            Boolean   @default(false)
  name                     String?
  image                    String?
  stripeCustomerId         String?
  lastActiveOrganizationId String?
  role                     String?
  banned                   Boolean?  @default(false)
  banReason                String?
  banExpires               DateTime?

  sessions             Session[]
  accounts             Account[]
  members              Member[]
  invitations          Invitation[]
  notifications        Notification[]
  leadLists            LeadList[]
  leadListFolders      LeadListFolder[]
  listFavorites        ListFavorite[]
  listOpens            ListOpen[]
  listEnrichmentJobs   ListEnrichmentJob[]
  vendorApiKeys        VendorApiKey[]
  copyGeneratorJobs    CopyGeneratorJob[]
  externalApiKeys      ExternalApiKey[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  impersonatedBy       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Organization {
  id                 String              @id
  name               String
  slug               String
  logo               String?
  createdAt          DateTime
  metadata           String?
  members              Member[]
  invitations          Invitation[]
  creditTransactions   CreditTransaction[]
  leadLists            LeadList[]
  leadListFolders      LeadListFolder[]
  leads                Lead[]
  listEnrichmentJobs   ListEnrichmentJob[]
  vendorApiKeys        VendorApiKey[]
  copyGeneratorJobs    CopyGeneratorJob[]
  externalApiKeys      ExternalApiKey[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  createdAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

model Subscription {
  id                   String    @id
  plan                 String
  referenceId          String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String?   @default("incomplete")
  periodStart          DateTime?
  periodEnd            DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean?  @default(false)
  seats                Int?

  @@map("subscription")
}

model CreditTransaction {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentInvoiceId String
  amount           Int
  type             String
  metadata         Json
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("credit_transaction")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  message   String
  link      String?
  readAt    DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification")
}

model Example {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("example")
}

model Enrichment {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  linkedinUrl    String
  status         String    // pending, completed, not_found, error
  enrichMobile   Boolean   @default(true)

  // Results
  email          String?
  emailVerified  Boolean?
  mobile         String?
  firstName      String?
  lastName       String?
  title          String?
  companyName    String?
  companyDomain  String?

  // Meta
  rawResponse    Json?
  errorCode      String?
  creditsCost    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  @@index([organizationId])
  @@map("enrichment")
}

model BulkEnrichmentJob {
  id               String   @id @default(uuid())
  organizationId   String
  userId           String
  status           String   // pending, processing, completed, failed
  jobType          String   @default("linkedin") // linkedin, people_search
  totalRecords     Int
  processedRecords Int      @default(0)
  matchedRecords   Int      @default(0)
  failedRecords    Int      @default(0)
  originalFileName String
  totalCreditsCost Int      @default(0)
  enrichMobile     Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  completedAt      DateTime?

  items BulkEnrichmentItem[]

  @@index([organizationId])
  @@map("bulk_enrichment_job")
}

model BulkEnrichmentItem {
  id          String   @id @default(uuid())
  jobId       String
  identifier  String
  linkedinUrl String?  // Optional - populated directly for linkedin jobs, or found via search for people_search jobs
  status      String   // pending, searching, matched, not_matched, error

  // Input fields for people_search job type
  inputCompany String?
  inputDomain  String?
  inputRole    String?

  // Output fields
  email       String?
  mobile      String?
  firstName   String?
  lastName    String?
  title       String?
  companyName String?
  errorCode   String?
  rawResponse Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job BulkEnrichmentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("bulk_enrichment_item")
}

model Waitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())

  @@map("waitlist")
}

model ScrapeJob {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  name           String
  status         String    @default("pending") // pending, processing, completed, failed, paused
  totalRows      Int
  processedRows  Int       @default(0)
  successCount   Int       @default(0)
  errorCount     Int       @default(0)
  inputType      String    // name, role, company, domain, url
  resultListId   String?
  // New workflow fields
  workflowType   String?   // company_csv, name_csv, domain_csv, single_url, pdf_upload
  roleConfigs    Json?     // Array of {roleName: string, count: number}
  sourceUrl      String?   // For single URL workflow
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  items ScrapeJobItem[]

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@map("scrape_job")
}

model ScrapeJobItem {
  id             String    @id @default(uuid())
  jobId          String
  rowIndex       Int
  inputData      Json
  linkedinUrl    String?
  companyDomain  String?   // Company domain scraped during job
  status         String    @default("pending") // pending, processing, completed, failed, no_result
  serperResponse Json?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  job ScrapeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
  @@map("scrape_job_item")
}

// ==========================================
// Lists Feature Models
// ==========================================

model LeadList {
  id             String   @id @default(uuid())
  organizationId String
  createdById    String
  name           String
  description    String?
  folderId       String?
  importStatus   String   @default("completed") // pending, processing, completed, failed
  leadCount      Int      @default(0)
  source         String   @default("uploaded") // uploaded, scraped
  scrapeJobId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                  @relation(fields: [createdById], references: [id])
  folder          LeadListFolder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  leads           Lead[]
  favorites       ListFavorite[]
  opens           ListOpen[]
  enrichmentJobs  ListEnrichmentJob[]
  copyGeneratorJobs CopyGeneratorJob[]

  @@index([organizationId])
  @@index([folderId])
  @@index([createdById])
  @@map("lead_list")
}

model LeadListFolder {
  id             String   @id @default(uuid())
  organizationId String
  createdById    String
  name           String
  parentId       String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User             @relation(fields: [createdById], references: [id])
  parent       LeadListFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     LeadListFolder[] @relation("FolderHierarchy")
  lists        LeadList[]
  favorites    ListFavorite[]
  opens        ListOpen[]

  @@index([organizationId])
  @@index([parentId])
  @@index([createdById])
  @@map("lead_list_folder")
}

model ListFavorite {
  id        String   @id @default(uuid())
  userId    String
  listId    String?
  folderId  String?
  createdAt DateTime @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  list   LeadList?       @relation(fields: [listId], references: [id], onDelete: Cascade)
  folder LeadListFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
  @@unique([userId, folderId])
  @@index([userId])
  @@map("list_favorite")
}

model ListOpen {
  id       String   @id @default(uuid())
  userId   String
  listId   String?
  folderId String?
  openedAt DateTime @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  list   LeadList?       @relation(fields: [listId], references: [id], onDelete: Cascade)
  folder LeadListFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([userId, openedAt(sort: Desc)])
  @@index([listId])
  @@index([folderId])
  @@map("list_open")
}

model Lead {
  id             String   @id @default(uuid())
  listId         String
  organizationId String
  firstName      String?
  lastName       String?
  email          String?
  phone          String?
  company        String?
  role           String?
  linkedinUrl    String?
  customFields   Json     @default("{}")
  // New fields for enhanced enrichment
  firstLine      String?  // AI-generated personalized first line
  companyDomain  String?  // Cached company domain for email guessing
  emailBounced   Boolean  @default(false) // Flag for bounced email validation
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  list            LeadList                @relation(fields: [listId], references: [id], onDelete: Cascade)
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrichmentItems ListEnrichmentJobItem[]
  copyGeneratorItems CopyGeneratorJobItem[]
  emailValidationAttempts EmailValidationAttempt[]

  @@index([listId])
  @@index([organizationId])
  @@map("lead")
}

// ==========================================
// List Enrichment Feature Models
// ==========================================

model ListEnrichmentJob {
  id              String    @id @default(uuid())
  organizationId  String
  userId          String
  listId          String
  vendor          String    @default("prospeo") // prospeo, apollo, hunter, clearbit
  enrichmentType  String    // email, phone
  status          String    @default("pending") // pending, processing, completed, failed
  totalRows       Int
  processedRows   Int       @default(0)
  successCount    Int       @default(0)
  errorCount      Int       @default(0)
  creditsUsed     Int       @default(0)
  // Email guessing strategy fields
  enrichmentStrategy  String  @default("direct") // direct, guess_first, guess_only
  guessSuccessCount   Int     @default(0)
  fallbackCount       Int     @default(0)
  validationCredits   Int     @default(0)
  // Email verification fields
  verificationStage   String  @default("pending") // pending, smtp_verifying, awaiting_decision, api_verifying, completed
  verificationMethod  String  @default("smtp_only") // smtp_only, smtp_api_fallback, api_only
  smtpValidCount      Int     @default(0)
  smtpInvalidCount    Int     @default(0)
  smtpCatchAllCount   Int     @default(0)
  smtpUnknownCount    Int     @default(0)
  smtpCompletedAt     DateTime?
  userDecision        String?   // accept_current, fill_all_gaps, fill_unknowns_only, fill_catchall_only
  decisionMadeAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                    @relation(fields: [userId], references: [id])
  list         LeadList                @relation(fields: [listId], references: [id], onDelete: Cascade)
  items        ListEnrichmentJobItem[]

  @@index([organizationId])
  @@index([userId])
  @@index([listId])
  @@index([status])
  @@index([verificationStage])
  @@map("list_enrichment_job")
}

model ListEnrichmentJobItem {
  id              String    @id @default(uuid())
  jobId           String
  leadId          String
  linkedinUrl     String
  status          String    @default("pending") // pending, processing, completed, failed, not_found
  enrichedEmail   String?
  enrichedPhone   String?
  prospeoResponse Json?
  errorMessage    String?
  createdAt       DateTime  @default(now())
  processedAt     DateTime?

  job  ListEnrichmentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lead Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([leadId])
  @@index([status])
  @@map("list_enrichment_job_item")
}

model VendorApiKey {
  id             String   @id @default(uuid())
  organizationId String
  vendor         String   // prospeo, apollo, hunter, clearbit, openrouter, millionverifier
  encryptedKey   String
  isActive       Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@unique([organizationId, vendor])
  @@index([organizationId])
  @@map("vendor_api_key")
}

// ==========================================
// External API Key Models (for third-party integrations)
// ==========================================

model ExternalApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String    // Friendly name like "GTM Dialer Integration"
  keyPrefix      String    // First 8 chars for identification (e.g., "ee_live_")
  hashedKey      String    // bcrypt hash of the full key
  scopes         String[]  // Array of scopes: ["lists:read", "lists:write", "leads:read"]
  isActive       Boolean   @default(true)
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([keyPrefix])
  @@map("external_api_key")
}

// ==========================================
// Copy Generator Feature Models
// ==========================================

model CopyGeneratorJob {
  id              String    @id @default(uuid())
  organizationId  String
  userId          String
  listId          String
  userPrompt      String
  status          String    @default("pending") // pending, processing, completed, failed
  totalRows       Int
  processedRows   Int       @default(0)
  successCount    Int       @default(0)
  errorCount      Int       @default(0)
  tokensUsed      Int       @default(0)
  estimatedCost   Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id])
  list         LeadList               @relation(fields: [listId], references: [id], onDelete: Cascade)
  items        CopyGeneratorJobItem[]

  @@index([organizationId])
  @@index([userId])
  @@index([listId])
  @@index([status])
  @@map("copy_generator_job")
}

model CopyGeneratorJobItem {
  id                String    @id @default(uuid())
  jobId             String
  leadId            String
  status            String    @default("pending") // pending, processing, completed, failed
  generatedLine     String?
  tokensUsed        Int       @default(0)
  openrouterResponse Json?
  errorMessage      String?
  createdAt         DateTime  @default(now())
  processedAt       DateTime?

  job  CopyGeneratorJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lead Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([leadId])
  @@index([status])
  @@map("copy_generator_job_item")
}

// ==========================================
// Email Guesser Feature Models
// ==========================================

model DomainEmailPattern {
  id             String   @id @default(uuid())
  domain         String   @unique
  patterns       Json     // Patterns sorted by success rate e.g., [{pattern: "first.last", successRate: 0.8}]
  successCount   Int      @default(0)
  totalAttempts  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("domain_email_pattern")
}

model EmailValidationAttempt {
  id                 String    @id @default(uuid())
  jobItemId          String
  leadId             String
  email              String
  pattern            String    // e.g., "first.last", "flast", "firstl"
  status             String    // valid, bounced, catch_all, unknown, error
  verificationSource String    @default("api") // smtp, api - how the email was verified
  smtpCode           Int?      // SMTP response code (250, 550, etc.)
  validationResponse Json?     // MillionVerifier API response or SMTP details
  createdAt          DateTime  @default(now())
  processedAt        DateTime?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([jobItemId])
  @@index([leadId])
  @@index([status])
  @@map("email_validation_attempt")
}

// ==========================================
// Domain MX Cache for SMTP Verification
// ==========================================

model DomainMxCache {
  id           String   @id @default(uuid())
  domain       String   @unique
  mxRecords    Json     // Array of MX records: [{host: "mx.google.com", priority: 10}]
  isCatchAll   Boolean? // null = not tested, true/false = tested
  isDisposable Boolean  @default(false)
  lastVerified DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([domain])
  @@index([lastVerified])
  @@map("domain_mx_cache")
}

// ==========================================
// Blog Feature Models
// ==========================================

model BlogPost {
  id            String    @id @default(uuid())
  slug          String    @unique
  title         String
  excerpt       String
  content       String    @db.Text
  category      String
  readTime      String
  author        String    @default("Enrich Team")
  isFeatured    Boolean   @default(false)
  gradientColor String?   // For featured post gradient styling
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([category])
  @@index([publishedAt])
  @@index([isFeatured])
  @@map("blog_post")
}

