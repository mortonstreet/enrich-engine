# Backend API URL
NEXT_PUBLIC_API_URL='http://localhost:8000/api'

# Domain Configuration (Production)
# Set these for multi-domain setup
NEXT_PUBLIC_APP_DOMAIN=app.enrichengine.io
NEXT_PUBLIC_WWW_DOMAIN=www.enrichengine.io

# Analytics - PostHog
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Analytics - Google
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your_ga_id

# Real-time Updates - Pusher
NEXT_PUBLIC_PUSHER_ENABLED=true
NEXT_PUBLIC_PUSHER_KEY=app-key
NEXT_PUBLIC_PUSHER_HOST=localhost
NEXT_PUBLIC_PUSHER_PORT=6001
NEXT_PUBLIC_PUSHER_USE_TLS=false

# Production Pusher (Soketi on Railway or Pusher.com)
# NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
# NEXT_PUBLIC_PUSHER_HOST=your-soketi.railway.app
# NEXT_PUBLIC_PUSHER_PORT=443
# NEXT_PUBLIC_PUSHER_USE_TLS=true
